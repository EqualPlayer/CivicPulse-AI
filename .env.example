# Choose: gemini
AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Configure these to use a hosted Supabase database.
# Keep the service-role key ONLY on the server. Never put it in frontend JavaScript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite fallback (used when Supabase credentials are not set)
DATABASE_PATH=civicpulse.db
MAX_UPLOAD_MB=8
